{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@dominic-nexus/shared": ["packages/shared/src/index.ts"],
      "@dominic-nexus/config": ["packages/config/src/index.ts"],
      "@dominic-nexus/logging": ["packages/logging/src/index.ts"],
      "@dominic-nexus/permissions": ["packages/permissions/src/index.ts"],
      "@dominic-nexus/secrets": ["packages/secrets/src/index.ts"],
      "@dominic-nexus/memory": ["packages/memory/src/index.ts"],
      "@dominic-nexus/tools": ["packages/tools/src/index.ts"],
      "@dominic-nexus/channels": ["packages/channels/src/index.ts"],
      "@dominic-nexus/providers": ["packages/providers/src/index.ts"],
      "@dominic-nexus/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@dominic-nexus/core": ["packages/core/src/index.ts"]
    }
  }
}
